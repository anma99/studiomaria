  .footer-links { display: flex; gap: 32px; }
  .footer-links a { color: #4a4a4a; text-decoration: none; font-size: 0.68rem; letter-spacing: 2px; text-transform: uppercase; transition: color 0.3s; cursor: pointer; }
  .footer-links a:hover { color: var(--gold); }
  .footer-copy { font-size: 0.65rem; color: #3a3a3a; letter-spacing: 1px; }

  @media(max-width:900px) {
    nav { padding: 20px 24px; }
    .nav-links { display: none; }
    .hero { padding: 120px 24px 60px; }
    .servicios, .proceso, .plantillas, .cta { padding: 60px 24px; }
    .faq { padding: 60px 24px; }
