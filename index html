  * { margin: 0; padding: 0; box-sizing: border-box; }
  :root { --black: #2c1a0e; --white: #ffffff; --gray: #f2ebe0; --mid: #8a7a6a; --accent: #4a3020; --gold: #8B6343; }
  body { font-family: 'Inter', sans-serif; background: var(--white); color: var(--black); }

  /* NAV */
  nav { position: fixed; top: 0; width: 100%; z-index: 100; display: flex; justify-content: space-between; align-items: center; padding: 24px 80px; background: rgba(255,255,255,0.97); backdrop-filter: blur(12px); border-bottom: 1px solid #ebebeb; }
