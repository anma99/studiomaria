  .nav-links { display: flex; gap: 40px; list-style: none; }
  .nav-links a { text-decoration: none; color: var(--black); font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; transition: color 0.3s; cursor: pointer; }
  .nav-links a:hover { color: var(--gold); }
  .btn-dark { background: var(--black); color: var(--white); border: none; padding: 12px 32px; font-family: 'Inter'; font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
  .btn-dark:hover { background: var(--gold); }
  .btn-outline { background: transparent; color: var(--black); border: 1px solid var(--black); padding: 12px 32px; font-family: 'Inter'; font-size: 0.7rem; letter-spacing: 3px; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
  .btn-outline:hover { background: var(--black); color: var(--white); }

  /* HERO */
  .hero { min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 120px 80px 80px; background: var(--white); position: relative; overflow: hidden; }
  .hero::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--gold), var(--black), var(--gold)); }
  .hero-inner { max-width: 800px; }
  .hero-tag { font-size: 0.65rem; letter-spacing: 6px; text-transform: uppercase; color: var(--gold); margin-bottom: 32px; display: block; }
  .hero h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(3.5rem, 7vw, 6rem); font-weight: 300; line-height: 1.05; margin-bottom: 32px; }
  .hero h1 em { font-style: italic; }
  .hero p { font-size: 0.92rem; color: var(--mid); line-height: 2; max-width: 560px; margin: 0 auto 48px; }
  .hero-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .hero-stats { display: flex; justify-content: center; gap: 60px; margin-top: 80px; padding-top: 60px; border-top: 1px solid #ebebeb; flex-wrap: wrap; }
  .hero-stat-num { font-family: 'Cormorant Garamond', serif; font-size: 3rem; font-weight: 300; }
  .hero-stat-label { font-size: 0.68rem; letter-spacing: 3px; text-transform: uppercase; color: var(--mid); margin-top: 4px; }

  /* MARQUEE */
  .marquee { background: var(--black); padding: 14px 0; overflow: hidden; white-space: nowrap; }
  .marquee-inner { display: inline-flex; animation: marquee 20s linear infinite; }
  .marquee span { font-size: 0.65rem; letter-spacing: 5px; text-transform: uppercase; color: #4a4a4a; padding: 0 40px; }
  .marquee span.gold { color: var(--gold); }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* SERVICIOS */
  .servicios { padding: 120px 80px; background: var(--gray); }
  .section-label { font-size: 0.65rem; letter-spacing: 5px; text-transform: uppercase; color: var(--gold); margin-bottom: 16px; }
  .section-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.4rem, 4vw, 3.5rem); font-weight: 300; margin-bottom: 60px; }
  .servicios-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .servicio-card { background: var(--white); padding: 48px 40px; transition: all 0.3s; position: relative; overflow: hidden; }
  .servicio-card::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 2px; background: var(--gold); transition: width 0.4s; }
  .servicio-card:hover::after { width: 100%; }
  .servicio-card:hover { transform: translateY(-4px); box-shadow: 0 20px 60px rgba(0,0,0,0.08); }
  .servicio-num { font-family: 'Cormorant Garamond', serif; font-size: 4rem; font-weight: 300; color: #ebebeb; margin-bottom: 24px; }
  .servicio-card h3 { font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-weight: 400; margin-bottom: 16px; }
  .servicio-card p { font-size: 0.82rem; color: var(--mid); line-height: 1.9; margin-bottom: 28px; }
  .servicio-features { list-style: none; margin-bottom: 32px; }
  .servicio-features li { font-size: 0.78rem; color: var(--black); padding: 8px 0; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center; gap: 10px; }
  .servicio-features li::before { content: '✦'; color: var(--gold); font-size: 0.6rem; flex-shrink: 0; }
  .servicio-price { font-family: 'Cormorant Garamond', serif; font-size: 2rem; font-weight: 300; margin-bottom: 24px; }
  .servicio-price span { font-size: 0.8rem; font-family: 'Inter'; color: var(--mid); }
  .badge-popular { position: absolute; top: 24px; right: 24px; background: var(--gold); color: white; font-size: 0.6rem; letter-spacing: 2px; padding: 4px 12px; text-transform: uppercase; }

  /* PROCESO */
  .proceso { padding: 120px 80px; background: var(--white); }
  .proceso-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; margin-top: 60px; }
  .proceso-step { position: relative; }
  .proceso-step::after { content: '→'; position: absolute; right: -24px; top: 20px; color: #ebebeb; font-size: 1.2rem; }
  .proceso-step:last-child::after { display: none; }
  .step-num { font-family: 'Cormorant Garamond', serif; font-size: 3.5rem; font-weight: 300; color: #ebebeb; margin-bottom: 16px; }
  .step-icon { width: 48px; height: 48px; border: 1px solid #ebebeb; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
  .step-icon svg { width: 24px; height: 24px; stroke: var(--black); fill: none; stroke-width: 1.5; stroke-linecap: round; }
  .proceso-step h4 { font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; margin-bottom: 10px; }
  .proceso-step p { font-size: 0.78rem; color: var(--mid); line-height: 1.8; }

  /* PLANTILLAS */
  .plantillas { padding: 120px 80px; background: var(--gray); }
  .plantillas-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 60px; }
  .plantilla-card { background: var(--white); overflow: hidden; cursor: pointer; transition: all 0.3s; }
  .plantilla-card:hover { transform: translateY(-6px); box-shadow: 0 20px 60px rgba(0,0,0,0.1); }
  .plantilla-preview { height: 240px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .plantilla-preview img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .plantilla-card:hover .plantilla-preview img { transform: scale(1.05); }
  .plantilla-preview.kbeauty { background: linear-gradient(135deg, #e8d8c8, #d8c8b8); }
  .plantilla-preview.moda { background: linear-gradient(135deg, #d8d0c8, #c8c0b0); }
  .plantilla-preview.restaurante { background: linear-gradient(135deg, #c8b898, #b8a888); }
  .plantilla-tag { position: absolute; top: 16px; left: 16px; background: var(--black); color: white; font-size: 0.6rem; letter-spacing: 2px; padding: 4px 10px; text-transform: uppercase; }
  .plantilla-info { padding: 28px; }
  .plantilla-info h3 { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; margin-bottom: 8px; }
  .plantilla-info p { font-size: 0.78rem; color: var(--mid); line-height: 1.7; margin-bottom: 16px; }
  .plantilla-footer { display: flex; justify-content: space-between; align-items: center; }
  .plantilla-price { font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; color: var(--gold); }
  .plantilla-btn { font-size: 0.65rem; letter-spacing: 2px; text-transform: uppercase; color: var(--black); text-decoration: none; border-bottom: 1px solid var(--black); padding-bottom: 2px; cursor: pointer; transition: color 0.3s; background: none; border-left: none; border-right: none; border-top: none; font-family: 'Inter'; }
  .plantilla-btn:hover { color: var(--gold); border-color: var(--gold); }

  /* FAQ */
  .faq { padding: 120px 80px; background: var(--white); max-width: 800px; margin: 0 auto; }
  .faq-item { border-bottom: 1px solid #ebebeb; }
  .faq-question { padding: 24px 0; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-family: 'Cormorant Garamond', serif; font-size: 1.15rem; }
  .faq-question:hover { color: var(--gold); }
  .faq-icon { font-size: 1.2rem; color: var(--mid); transition: transform 0.3s; flex-shrink: 0; }
  .faq-answer { font-size: 0.82rem; color: var(--mid); line-height: 2; max-height: 0; overflow: hidden; transition: max-height 0.4s, padding 0.3s; }
  .faq-answer.open { max-height: 200px; padding-bottom: 24px; }

  /* CTA */
  .cta { padding: 120px 80px; background: var(--black); text-align: center; }
  .cta h2 { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.8rem, 5vw, 4.5rem); font-weight: 300; color: var(--white); line-height: 1.1; margin-bottom: 24px; }
