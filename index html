  .cta p { font-size: 0.85rem; color: #7a7a7a; max-width: 480px; margin: 0 auto 48px; line-height: 1.9; }
  .btn-gold { background: var(--gold); color: white; border: none; padding: 16px 48px; font-family: 'Inter'; font-size: 0.72rem; letter-spacing: 3px; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
  .btn-gold:hover { background: white; color: var(--black); }
  .btn-outline-white { background: transparent; color: white; border: 1px solid rgba(255,255,255,0.3); padding: 16px 40px; font-family: 'Inter'; font-size: 0.72rem; letter-spacing: 3px; text-transform: uppercase; cursor: pointer; transition: all 0.3s; margin-left: 16px; }
  .btn-outline-white:hover { background: white; color: var(--black); }

  /* FOOTER */
  footer { background: var(--black); border-top: 1px solid #1a1a1a; padding: 40px 80px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; }
